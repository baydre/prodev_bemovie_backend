# Database Configuration (for container-to-container communication)
DATABASE_URL=postgres://bemovie_user:bemovie_password@db:5432/bemovie_db
DATABASE_HOST=db
DATABASE_PORT=5432
# Note: External access via localhost:5433
DATABASE_NAME=bemovie_db
DATABASE_USER=bemovie_user
DATABASE_PASSWORD=bemovie_password

# Redis Configuration (for container-to-container communication)
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
# Note: External access via localhost:6380

# Django Configuration
DJANGO_SETTINGS_MODULE=movie_rec_project.settings
DJANGO_SECRET_KEY=your-very-secret-key-change-this-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,your-domain.com

# Optional: Superuser Creation
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=secure-admin-password

# Additional Settings
PYTHONPATH=/app
UV_CACHE_DIR=/tmp/uv-cache

# External API Keys (if needed)
# TMDB_API_KEY=your-tmdb-api-key
# OTHER_API_KEY=your-other-api-key
